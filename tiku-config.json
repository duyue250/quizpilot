[
  {
    "name": "QuizPilot 智答领航（本地AI题库）",
    "homepage": "https://github.com/duyue250/quizpilot",
    "url": "http://127.0.0.1:8787/tiku/search",
    "method": "post",
    "contentType": "json",
    "data": {
      "title": "${title}",
      "type": "${type}",
      "options": "${options}"
    },
    "handler": "return (res) => res.code === 200 ? res.answer : undefined"
  }
]